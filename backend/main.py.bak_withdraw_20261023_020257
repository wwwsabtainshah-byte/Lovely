    _: bool = Depends(require_owner),
):
    expiry = ban_expiry(duration)

    with database() as db:
        row = db.execute(
            "SELECT device_id FROM accounts WHERE username = ?",
            (username,),
        ).fetchone()

        if not row:
            raise HTTPException(status_code=404, detail="Account not found")

        if duration == "permanent":
            db.execute("""
                UPDATE accounts
                SET account_ban_permanent = 1, account_ban_until = NULL,
                    banned = 1
                WHERE username = ?
            """, (username,))
        else:
            db.execute("""
                UPDATE accounts
                SET account_ban_permanent = 0, account_ban_until = ?,
                    banned = 1
                WHERE username = ?
            """, (expiry, username))

        db.execute("""
            DELETE FROM sessions
            WHERE account_id = (
                SELECT id FROM accounts WHERE username = ?
            )
        """, (username,))

        log_event(db, "ACCOUNT_BANNED", username, row["device_id"])

    return {
        "success": True,
        "username": username,
        "duration": duration,
        "expires_at": expiry,
        "status": "banned",
    }



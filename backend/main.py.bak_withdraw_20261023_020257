class HierarchyAssignRequest(BaseModel):
    username: str = Field(min_length=3, max_length=30)


def assign_lovely_role(data, creator, required_role, new_role):
    if creator.get("role") != required_role:
        raise HTTPException(
            status_code=403,
            detail="You are not authorized to assign this role"
        )

    with database() as db:
        target = db.execute(
            "SELECT id, username, role, user_code, approved, banned "
            "FROM accounts WHERE username = ?",
            (data.username,)
        ).fetchone()

        if not target:
            raise HTTPException(status_code=404, detail="Account not found")

        if target["id"] == creator["id"]:
            raise HTTPException(status_code=400, detail="Cannot assign your own role")

        if target["role"] != "user":
            raise HTTPException(
                status_code=409,
                detail="Account already has a privileged role"
            )

        if not target["approved"] or target["banned"]:
            raise HTTPException(
                status_code=403,
                detail="Account must be approved and active"
            )

        parent = db.execute(
            "SELECT id FROM accounts WHERE id = ? AND role = ?",
            (creator["id"], required_role)
        ).fetchone()

        if not parent:
            raise HTTPException(status_code=403, detail="Creator role invalid")

        code = target["user_code"]

        if not code:
            for _ in range(20):
                candidate = new_role.upper()[:3] + secrets.token_hex(5).upper()
                exists = db.execute(
                    "SELECT id FROM accounts WHERE user_code = ?",
                    (candidate,)
                ).fetchone()
                if not exists:
                    code = candidate
                    break
            else:
                raise HTTPException(status_code=503, detail="ID generation failed")

        try:
            updated = db.execute(
                "UPDATE accounts SET role = ?, user_code = ? "
                "WHERE id = ? AND role = 'user'",
                (new_role, code, target["id"])
            )

            if updated.rowcount != 1:
                raise HTTPException(status_code=409, detail="Role changed concurrently")

            db.execute(
                "INSERT INTO role_hierarchy "
                "(account_id, parent_account_id, assigned_role, created_at) "
                "VALUES (?, ?, ?, ?)",
                (target["id"], creator["id"], new_role, hosting_now())
            )

            log_event(
                db,
                "ROLE_ASSIGNED_" + new_role.upper(),
                target["username"]
            )

        except sqlite3.IntegrityError:
            raise HTTPException(
                status_code=409,
                detail="Role assignment or ID conflict"
            )

        return {
            "success": True,
            "username": target["username"],
            "role": new_role,
            "user_code": code,
            "assigned_by": creator["username"]
        }



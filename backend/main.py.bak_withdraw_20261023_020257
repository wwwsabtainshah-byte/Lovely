@app.post("/login")
def login(data: LoginRequest):

    with database() as db:

        account = db.execute(
            "SELECT * FROM accounts WHERE username = ?",
            (data.username,),
        ).fetchone()

        if not account or not verify_password(
            data.password,
            account["password_hash"],
        ):
            raise HTTPException(
                status_code=401,
                detail="Invalid username or password",
            )

        if not hmac.compare_digest(
            account["device_id"],
            data.device_id,
        ):
            log_event(
                db,
                "LOGIN_BLOCKED_WRONG_DEVICE",
                data.username,
                data.device_id,
            )

            raise HTTPException(
                status_code=403,
                detail="This account belongs to another device",
            )

        account = refresh_ban_state(db, account)
        if account["banned"]:
            raise HTTPException(
                status_code=403,
                detail="Account or device is banned",
            )


        token = secrets.token_urlsafe(32)

        token_hash = hashlib.sha256(
            token.encode()
        ).hexdigest()

        db.execute(
            """
            INSERT INTO sessions
            (token_hash, account_id, created_at, last_activity)
            VALUES (?, ?, ?, ?)
            """,
            (
                token_hash,
                account["id"],
                now(),
                now(),
            ),
        )

        log_event(
            db,
            "LOGIN_SUCCESS",
            data.username,
            data.device_id,
        )

    return {
        "success": True,
        "token": token,
        "username": data.username,
        "message": "Login successful",
    }


@app.post("/auth/google")
def google_login(data: dict):
    api_key = os.getenv("FIREBASE_WEB_API_KEY", "")
    id_token = data.get("id_token")
    device_id = data.get("device_id")

    if not api_key.startswith("AIza"):
        raise HTTPException(status_code=503, detail="Firebase API key is not configured")
    if not isinstance(id_token, str) or not id_token:
        raise HTTPException(status_code=400, detail="Firebase ID token is required")
    if not isinstance(device_id, str) or not 16 <= len(device_id) <= 256:
        raise HTTPException(status_code=400, detail="Valid device_id is required")

    url = "https://identitytoolkit.googleapis.com/v1/accounts:lookup?key=" + api_key
    body = json.dumps({"idToken": id_token}).encode("utf-8")
    req = urllib.request.Request(
        url, data=body, headers={"Content-Type": "application/json"}, method="POST"
    )

    try:
        with urllib.request.urlopen(req, timeout=15) as response:
            result = json.loads(response.read().decode("utf-8"))
        users = result.get("users", [])
        if not users:
            raise HTTPException(status_code=401, detail="Invalid Google login token")
        user = users[0]
    except HTTPException:
        raise
    except urllib.error.HTTPError:
        raise HTTPException(status_code=401, detail="Firebase rejected the login token")
    except (urllib.error.URLError, TimeoutError, ConnectionError, OSError, json.JSONDecodeError):
        raise HTTPException(status_code=502, detail="Could not verify login with Firebase")

    google_uid = user.get("localId")
    email = user.get("email", "").strip().lower()
    if not google_uid or not email or not user.get("emailVerified", False):
        raise HTTPException(status_code=401, detail="A verified Google email is required")

    with database() as db:
        account = db.execute(
            "SELECT * FROM accounts WHERE google_uid = ?", (google_uid,)
        ).fetchone()

        if account:
            if not hmac.compare_digest(account["device_id"], device_id):
                raise HTTPException(status_code=403, detail="This account belongs to another device")
            account = refresh_ban_state(db, account)
            if account["banned"]:
                raise HTTPException(status_code=403, detail="Account or device is banned")
            if not account["approved"]:
                raise HTTPException(status_code=403, detail="Account approval pending")
            username = account["username"]
            account_id = account["id"]
        else:
            device_account = db.execute(
                "SELECT username FROM accounts WHERE device_id = ?", (device_id,)
            ).fetchone()
            if device_account:
                raise HTTPException(
                    status_code=409,
                    detail="This device already belongs to another account"
                )

            base = "".join(c.lower() if c.isalnum() else "_" for c in email.split("@")[0])
            base = base.strip("_")[:20] or "lovely_user"
            username = base
            suffix = 1
            while db.execute(
                "SELECT 1 FROM accounts WHERE username = ?", (username,)
            ).fetchone():
                suffix += 1
                username = f"{base[:15]}_{suffix}"

            db.execute(
                """INSERT INTO accounts
                   (username, password_hash, device_id, approved, banned,
                    created_at, google_uid, google_email)
                   VALUES (?, ?, ?, 1, 0, ?, ?, ?)""",
                (
                    username,
                    hash_password(secrets.token_urlsafe(32)),
                    device_id,
                    now(),
                    google_uid,
                    email,
                ),
            )
            account_id = db.execute(
                "SELECT id FROM accounts WHERE google_uid = ?", (google_uid,)
            ).fetchone()["id"]
            log_event(db, "GOOGLE_LOGIN_ACCOUNT_CREATED", username, device_id)

        token = secrets.token_urlsafe(32)
        token_hash = hashlib.sha256(token.encode()).hexdigest()
        db.execute(
            """INSERT INTO sessions (token_hash, account_id, created_at, last_activity)
               VALUES (?, ?, ?, ?)""",
            (token_hash, account_id, now(), now()),
        )
        log_event(db, "GOOGLE_LOGIN_SUCCESS", username, device_id)

    return {
        "success": True,
        "token": token,
        "username": username,
        "message": "Google login successful",
    }



# LOVELY_WEBSOCKET_CHAT_V1
import json
from datetime import datetime, timezone

class LovelyChatConnections:
    def __init__(self):
        self.rooms = {}

    async def connect(self, username, websocket):
        await websocket.accept()
        self.rooms.setdefault(username, set()).add(websocket)

    def disconnect(self, username, websocket):
        connections = self.rooms.get(username, set())
        connections.discard(websocket)
        if not connections:
            self.rooms.pop(username, None)

    async def deliver(self, username, payload):
        dead = []
        for ws in list(self.rooms.get(username, set())):
            try:
                await ws.send_json(payload)
            except Exception:
                dead.append(ws)
        for ws in dead:
            self.disconnect(username, ws)

lovely_chat_connections = LovelyChatConnections()

@app.websocket("/ws/chat/{username}")
async def lovely_chat_websocket(websocket: WebSocket, username: str):
    # Authentication is required. Send the existing login token as
    # the "token" query parameter; never use an Owner token here.
    token = websocket.query_params.get("token")
    if not token:
        await websocket.close(code=1008, reason="Authentication required")
        return

    # Reuse the existing account/token validation.
    authorization = "Bearer " + token
    try:
        account = get_current_account(authorization=authorization)
    except Exception:
        await websocket.close(code=1008, reason="Invalid session")
        return

    if not account or account.get("username") != username:
        await websocket.close(code=1008, reason="Username mismatch")
        return

    await lovely_chat_connections.connect(username, websocket)
    try:
        while True:
            data = await websocket.receive_json()
            recipient = str(data.get("to", "")).strip()
            message = str(data.get("message", "")).strip()

            if not recipient or not message:
                await websocket.send_json({
                    "type": "error",
                    "message": "Recipient and message are required"
                })
                continue

            if len(message) > 4000:
                await websocket.send_json({
                    "type": "error",
                    "message": "Message is too long"
                })
                continue

            payload = {
                "type": "message",
                "from": username,
                "to": recipient,
                "message": message,
                "timestamp": datetime.now(timezone.utc).isoformat()
            }

            await lovely_chat_connections.deliver(recipient, payload)
            await websocket.send_json({
                "type": "sent",
                "to": recipient,
                "timestamp": payload["timestamp"]
            })
    except WebSocketDisconnect:
        pass
    except Exception:
        try:
            await websocket.close(code=1011, reason="Chat connection error")
        except Exception:
            pass
    finally:
        lovely_chat_connections.disconnect(username, websocket)

# ---------------- LOVELY VOICE ROOM SIGNALING ----------------
from typing import Dict
from fastapi import WebSocket, WebSocketDisconnect

# Each room maps authenticated usernames to their WebSocket connections.
_lovely_voice_rooms: Dict[str, Dict[str, WebSocket]] = {}


@app.websocket("/ws/voice/{room_id}")
async def lovely_voice_signaling(websocket: WebSocket, room_id: str):
    token = websocket.query_params.get("token")
    username = websocket.query_params.get("username")

    if not token or not username or not room_id.strip():
        await websocket.close(code=1008, reason="Authentication required")
        return

    try:
        account = get_current_account(authorization="Bearer " + token)
        if hasattr(account, "__await__"):
            account = await account

        account_username = (
            account.get("username") if isinstance(account, dict)
            else getattr(account, "username", None)
        )
        if account_username != username:
            await websocket.close(code=1008, reason="Username mismatch")
            return
    except Exception:
        await websocket.close(code=1008, reason="Invalid session")
        return

    await websocket.accept()
    room = _lovely_voice_rooms.setdefault(room_id, {})

    # Do not allow the same username to occupy two connections in one room.
    old = room.get(username)
    if old is not None:
        try:
            await websocket.close(code=1008, reason="Already connected to this room")
        except Exception:
            pass
        return

    existing_users = list(room.keys())
    room[username] = websocket

    try:
        await websocket.send_json({
            "type": "room_joined",
            "room_id": room_id,
            "username": username,
            "participants": existing_users,
        })

        for other_name, peer in list(room.items()):
            if other_name == username:
                continue
            try:
                await peer.send_json({
                    "type": "peer_joined",
                    "room_id": room_id,
                    "username": username,
                })
            except Exception:
                pass

        while True:
            message = await websocket.receive_json()
            message_type = message.get("type")
            target = message.get("target")

            if message_type not in {
                "offer", "answer", "ice_candidate", "mute_state"
            } or not isinstance(target, str) or target == username:
                await websocket.send_json({
                    "type": "error",
                    "detail": "Invalid signaling message or target",
                })
                continue

            peer = room.get(target)
            if peer is None:
                await websocket.send_json({
                    "type": "peer_unavailable",
                    "target": target,
                })
                continue

            await peer.send_json({
                "type": message_type,
                "from": username,
                "payload": message.get("payload"),
            })

    except WebSocketDisconnect:
        pass
    except Exception:
        try:
            await websocket.close(code=1011, reason="Voice signaling error")
        except Exception:
            pass
    finally:
        if room.get(username) is websocket:
            room.pop(username, None)

        for peer in list(room.values()):
            try:
                await peer.send_json({
                    "type": "peer_left",
                    "room_id": room_id,
                    "username": username,
                })
            except Exception:
                pass

        if not room:
            _lovely_voice_rooms.pop(room_id, None)




@app.post("/host/agent/link")
def host_link_agent(
    data: HostAgentLinkRequest,
    account=Depends(get_current_account),
):
    if account.get("role") != "host":
        raise HTTPException(
            status_code=403,
            detail="Host role required"
        )

    with database() as db:
        host = db.execute(
            "SELECT id, username FROM accounts WHERE id = ?",
            (account["id"],),
        ).fetchone()
        agent = db.execute(
            "SELECT id, username, user_code, role FROM accounts WHERE user_code = ?",
            (data.agent_id,),
        ).fetchone()

        if not agent:
            raise HTTPException(status_code=404, detail="Agent ID not found")
        if agent["role"] != "agent":
            raise HTTPException(status_code=400, detail="This ID does not belong to an Agent")
        if agent["id"] == host["id"]:
            raise HTTPException(status_code=400, detail="You cannot link your own ID")

        existing = db.execute(
            "SELECT agent_account_id FROM host_agent_links WHERE host_account_id = ?",
            (host["id"],),
        ).fetchone()
        if existing:
            raise HTTPException(
                status_code=409,
                detail="An agent is already linked. Remove the current link first.",
            )

        db.execute("""
            INSERT INTO host_agent_links(host_account_id, agent_account_id, linked_at)
            VALUES (?, ?, ?)
        """, (host["id"], agent["id"], hosting_now()))

        return {
            "success": True,
            "message": "Agent linked successfully",
            "agent": agent_public_profile(agent),
        }


@app.post("/host/agent/unlink")
def host_unlink_agent(account=Depends(get_current_account)):
    if account.get("role") != "host":
        raise HTTPException(
            status_code=403,
            detail="Host role required"
        )

    with database() as db:
        link = db.execute(
            "SELECT agent_account_id FROM host_agent_links WHERE host_account_id = ?",
            (account["id"],),
        ).fetchone()
        if not link:
            raise HTTPException(status_code=404, detail="No agent is linked")

        wallet = get_wallet_row(db, account["id"])
        if wallet["coins"] < HOST_UNLINK_FEE:
            raise HTTPException(
                status_code=402,
                detail={
                    "message": "Not enough coins to remove the agent",
                    "required_coins": HOST_UNLINK_FEE,
                    "current_coins": wallet["coins"],
                },
            )

        now = hosting_now()
        updated = db.execute("""
            UPDATE wallets
            SET coins = coins - ?, updated_at = ?
            WHERE account_id = ? AND coins >= ?
        """, (HOST_UNLINK_FEE, now, account["id"], HOST_UNLINK_FEE))

        if updated.rowcount != 1:
            raise HTTPException(status_code=402, detail="Insufficient coins")

        db.execute("""
            INSERT INTO wallet_transactions
                (account_id, amount, transaction_type, description, created_at)
            VALUES (?, ?, ?, ?, ?)
        """, (
            account["id"],
            -HOST_UNLINK_FEE,
            "host_agent_unlink_fee",
            "Host Center agent unlink fee",
            now,
        ))

        db.execute(
            "DELETE FROM host_agent_links WHERE host_account_id = ?",
            (account["id"],),
        )

        remaining = db.execute(
            "SELECT coins FROM wallets WHERE account_id = ?",
            (account["id"],),
        ).fetchone()["coins"]

        return {
            "success": True,
            "message": "Agent removed successfully",
            "coins_deducted": HOST_UNLINK_FEE,
            "remaining_coins": remaining,
        }



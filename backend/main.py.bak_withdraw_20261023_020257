def init_hosting_wallet_schema():
    with database() as db:
        db.executescript("""
            CREATE TABLE IF NOT EXISTS wallets (
                account_id INTEGER PRIMARY KEY,
                coins INTEGER NOT NULL DEFAULT 0 CHECK(coins >= 0),
                diamonds INTEGER NOT NULL DEFAULT 0 CHECK(diamonds >= 0),
                updated_at TEXT NOT NULL,
                FOREIGN KEY(account_id) REFERENCES accounts(id) ON DELETE CASCADE
            );

            CREATE TABLE IF NOT EXISTS host_agent_links (
                host_account_id INTEGER PRIMARY KEY,
                agent_account_id INTEGER NOT NULL,
                linked_at TEXT NOT NULL,
                FOREIGN KEY(host_account_id) REFERENCES accounts(id) ON DELETE CASCADE,
                FOREIGN KEY(agent_account_id) REFERENCES accounts(id) ON DELETE CASCADE,
                CHECK(host_account_id != agent_account_id)
            );

            CREATE TABLE IF NOT EXISTS wallet_transactions (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                account_id INTEGER NOT NULL,
                amount INTEGER NOT NULL,
                transaction_type TEXT NOT NULL,
                description TEXT NOT NULL,
                created_at TEXT NOT NULL,
                FOREIGN KEY(account_id) REFERENCES accounts(id) ON DELETE CASCADE
            );
        """)


def hosting_now():
    return datetime.now(timezone.utc).isoformat()


def get_wallet_row(db, account_id):
    db.execute(
        "INSERT OR IGNORE INTO wallets(account_id, coins, diamonds, updated_at) "
        "VALUES (?, 0, 0, ?)",
        (account_id, hosting_now()),
    )
    return db.execute(
        "SELECT coins, diamonds FROM wallets WHERE account_id = ?",
        (account_id,),
    ).fetchone()



@app.post("/register", status_code=201)
def register(data: RegisterRequest):

    with database() as db:

        existing_device = db.execute(
            "SELECT username FROM accounts WHERE device_id = ?",
            (data.device_id,),
        ).fetchone()

        if existing_device:
            log_event(
                db,
                "REGISTRATION_BLOCKED_DEVICE_ALREADY_USED",
                data.username,
                data.device_id,
            )

            raise HTTPException(
                status_code=409,
                detail="This device is already linked to an account",
            )

        existing_user = db.execute(
            "SELECT id FROM accounts WHERE username = ?",
            (data.username,),
        ).fetchone()

        if existing_user:
            raise HTTPException(
                status_code=409,
                detail="Username already exists",
            )

        db.execute(
            """
            INSERT INTO accounts
            (
                username,
                password_hash,
                device_id,
                approved,
                banned,
                created_at
            )
            VALUES (?, ?, ?, 1, 0, ?)
            """,
            (
                data.username,
                hash_password(data.password),
                data.device_id,
                now(),
            ),
        )

        log_event(
            db,
            "ACCOUNT_REGISTERED_PENDING_APPROVAL",
            data.username,
            data.device_id,
        )

    return {
        "success": True,
        "status": "active",
        "message": "Registration successful",
    }


